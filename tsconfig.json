{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "jsx": "react-jsx"
  },
  "include": [
    "shared/types.d.ts",
    "shared/constants.mjs",
    "shared/monitoringService.mjs",
    "shared/model3d.mjs",
    "shared/passkeyService.mjs",
    "shared/landmarkService.mjs",
    "shared/pinService.mjs",
    "client/src/utils/chainLinks.js",
    "client/src/utils/orbTracker.js",
    "client/src/utils/passkeyClient.js"
  ]
}
