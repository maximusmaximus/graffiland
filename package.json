{
  "name": "graffiland",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SPRAY.LAND — Location-bound 3D AR voxel graffiti & Virtual Land NFTs on IPFS and Robinhood Chain",
  "bin": {
    "graffiland-mcp": "./bin/graffiland-mcp.mjs",
    "graffiland": "./bin/graffiland.mjs"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c cyan,magenta \"node server/index.mjs\" \"vite --host\"",
    "dev:server": "node server/index.mjs",
    "dev:client": "vite --host",
    "lint": "eslint shared server bin client/src worker/src contracts tests",
    "format": "prettier --write \"shared/**/*.mjs\" \"server/**/*.mjs\" \"worker/src/**/*.js\" \"client/src/**/*.{js,jsx}\"",
    "format:check": "prettier --check \"shared/**/*.mjs\" \"server/**/*.mjs\" \"worker/src/**/*.js\"",
    "typecheck": "tsc -p tsconfig.json",
    "build": "vite build",
    "build:pages": "node scripts/build-pages.mjs",
    "deploy:pages": "node scripts/deploy-pages.mjs",
    "start": "node server/index.mjs --prod",
    "contract:compile": "node contracts/compile.mjs",
    "contract:deploy": "node contracts/deploy.mjs",
    "deploy:worker": "npx wrangler deploy --config worker/wrangler.toml",
    "deploy:worker:db": "npx wrangler d1 execute graffiland-db --remote --config worker/wrangler.toml --file=worker/schema.sql --yes",
    "media:backfill:r2": "node scripts/backfill-r2-media.mjs",
    "snapshot:testnet": "node scripts/export-testnet-snapshot.mjs",
    "snapshot:testnet:r2": "node scripts/export-testnet-snapshot.mjs --upload-r2",
    "mainnet:replay:dry": "node scripts/replay-mainnet-genesis.mjs --dry-run",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node tests/e2e.playwright.mjs",
    "test:ux": "node --test tests/ui.test.mjs && node tests/e2e.playwright.mjs"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.5",
    "express": "^4.21.2",
    "google-auth-library": "^9.15.1",
    "jsonwebtoken": "^9.0.2",
    "jsqr": "^1.4.0",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^6.19.0",
    "multiformats": "^13.3.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.174.0",
    "ws": "^8.18.1",
    "xeroemoji": "^1.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "playwright-core": "^1.65.1",
    "prettier": "^3.10.1",
    "solc": "^0.8.28",
    "typescript": "^7.0.2",
    "vite": "^6.2.0"
  }
}
