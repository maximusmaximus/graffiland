# Server & Runtime
PORT=3001
PUBLIC_URL=https://localhost:5173
SESSION_SECRET=change-this-to-a-long-random-secret-in-production
WALLET_ENCRYPTION_KEY=change-this-32-byte-secret-for-embedded-wallets

# Google OAuth (required for production Google login; dev fallback is enabled if blank)
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
ALLOW_DEV_GOOGLE_AUTH=true

# Admin Moderation (comma-separated Google email addresses)
ADMIN_EMAILS=admin@graffiland.local

# IPFS Pinning (Pinata JWT or local Kubo IPFS URL; local CIDv1 fallback is active if blank)
PINATA_JWT=
IPFS_API_URL=
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs

# Robinhood Chain (Testnet Chain ID 46630 / Mainnet Chain ID 4663)
ROBINHOOD_NETWORK=testnet
ROBINHOOD_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com
ROBINHOOD_MAINNET_RPC=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_CONTRACT_ADDRESS=
ROBINHOOD_RELAYER_PRIVATE_KEY=
ROBINHOOD_ROYALTY_RECEIVER=
ROBINHOOD_RESALE_FEE_BPS=500
